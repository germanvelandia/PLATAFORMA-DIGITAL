:root {
  --bg-color: #0f172a;
  --panel-bg: #1e293b;
  --accent: #38bdf8;
  --text: #f8fafc;
}

body {
  font-family: system-ui, -apple-system, sans-serif;
  background-color: var(--bg-color);
  color: var(--text);
  margin: 0;
  padding: 0;
}

.navbar {
  background: var(--panel-bg);
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid #334155;
}

.nav-btn {
  background: transparent;
  color: var(--text);
  border: 1px solid #334155;
  padding: 8px 16px;
  border-radius: 6px;
  cursor: pointer;
}

.nav-btn.active {
  background: var(--accent);
  color: #000;
  font-weight: bold;
}

.main-container { padding: 20px; max-width: 1100px; margin: auto; }

.tab-content { display: none; }
.active-tab { display: block; }

.character-card {
  background: var(--panel-bg);
  padding: 20px;
  border-radius: 12px;
  width: 260px;
  border: 1px solid #334155;
}

.progress-bar { background: #0f172a; height: 10px; border-radius: 5px; overflow: hidden; }
.fill.hp { background: #ef4444; height: 100%; }
.fill.xp { background: #10b981; height: 100%; }

.observador-sheet {
  background: #ffffff;
  color: #000000;
  padding: 25px;
  border-radius: 8px;
}

.report-table, .info-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 15px;
}

.report-table th, .report-table td, .info-table td {
  border: 1px solid #ccc;
  padding: 8px;
  text-align: left;
}

.btn-print {
  background: #10b981;
  color: white;
  border: none;
  padding: 10px 15px;
  border-radius: 6px;
  cursor: pointer;
  margin-bottom: 15px;
}

.print-only { display: none; }
